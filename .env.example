# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=modaco
POSTGRES_PASSWORD=modaco_dev_password
POSTGRES_DB=modaco

# Applications connect through PgBouncer (connection-storm protection, ADR-005).
DATABASE_URL=postgres://modaco:modaco_dev_password@pgbouncer:6432/modaco
# Migrations connect directly: DDL needs session state, which transaction pooling
# does not preserve.
DATABASE_DIRECT_URL=postgres://modaco:modaco_dev_password@postgres:5432/modaco

API_DB_POOL_MAX=20
INGESTION_DB_POOL_MAX=2

# ── Redis ───────────────────────────────────────────────────────────────────
# Cache (evictable) and queue (durable) are separate instances — see docker-compose.yml.
REDIS_URL=redis://redis:6379
REDIS_QUEUE_URL=redis://redis-queue:6379

# ── AWS / LocalStack ────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=modaco-vendor-feeds
SQS_INGESTION_QUEUE=modaco-ingestion
SQS_INGESTION_DLQ=modaco-ingestion-dlq
SQS_SPLITTER_QUEUE=modaco-splitter

# ── Application ─────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
# Human-readable logs locally; leave false anywhere logs are collected.
LOG_PRETTY=false
NODE_ENV=development

# Cache TTLs (seconds)
CACHE_PRODUCT_TTL=60
CACHE_LIST_TTL=30
CACHE_NEGATIVE_TTL=10

# Scenario A: chunk size in bytes. 2 MB is roughly 17K rows, a few seconds per worker.
INGESTION_CHUNK_BYTES=2097152
INGESTION_UPSERT_BATCH=1000
# When a worker's remaining time drops below this, it hands the rest to itself.
INGESTION_CONTINUATION_THRESHOLD_MS=30000

# Scenario B: projection batch size
PROJECTION_BATCH_SIZE=5000
PROJECTION_RECONCILE_INTERVAL_MS=60000
# Products the reconciler examines per sweep; bounds its cost, lengthens full coverage.
PROJECTION_SCAN_WINDOW=100000

# Mounts /internal/bench/* so bench/src/bench-detail.ts can compare read strategies with
# the cache bypassed. Unauthenticated and cache-bypassing by design, so the default is off.
# Set to true locally to reproduce the measurements in ADR-011.
ENABLE_BENCH_ROUTES=false

# ── Host port bindings ──────────────────────────────────────────────────────
# Only affect what the host sees; containers always talk to each other on the
# canonical ports. Change these if something already occupies one on your machine.
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
REDIS_HOST_PORT=6379
REDIS_QUEUE_HOST_PORT=6380
LOCALSTACK_HOST_PORT=4566
PROJECTOR_METRICS_PORT=3001
